<?xml version="1.0" encoding="utf-8"?>
<!-- One grid tile, cyberpunk look. Same ids as the stock item (AppAdapter looks them up); the card
     is a CyberTileFrame, which paints the cut corners and the magenta edge. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <com.gathin.tvhome.CyberTileFrame
        android:id="@+id/card"
        android:layout_width="180dp"
        android:layout_height="101dp"
        android:layout_gravity="center_horizontal|top"
        android:background="@drawable/tile_bg"
        android:focusable="true"
        android:clickable="true">

        <ImageView
            android:id="@+id/banner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:layout_marginBottom="14dp"
            android:visibility="gone"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/cyber_text"
            android:textSize="15sp"
            android:fontFamily="@font/rajdhani_bold"
            android:letterSpacing="0.04"
            android:visibility="gone" />
    </com.gathin.tvhome.CyberTileFrame>

    <TextView
        android:id="@+id/name"
        android:layout_width="180dp"
        android:layout_height="22dp"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="108dp"
        android:gravity="center"
        android:singleLine="true"
        android:ellipsize="end"
        android:alpha="0"
        android:translationY="-6dp"
        android:textColor="@color/cyber_dim"
        android:textSize="12sp"
        android:fontFamily="@font/jetbrains_mono"
        android:letterSpacing="0.15"
        android:textAllCaps="true" />
</FrameLayout>
