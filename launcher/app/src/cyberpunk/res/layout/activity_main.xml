<?xml version="1.0" encoding="utf-8"?>
<!-- Cyberpunk home. Same view ids as the stock layout (MainActivity looks them up); only the look
     differs: floor grid and scanlines in the background, cut-corner tiles, a neon frame for focus
     and a bottom module for IoT and system status. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cyber_bg">

    <!-- Perspective floor grid along the bottom; drawn once, never animated. -->
    <com.gathin.tvhome.HorizonGridView
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:layout_gravity="bottom"
        android:importantForAccessibility="no" />

    <!-- Ambient glow in the colour of the focused dock app. -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <!-- Top shelf: the focused dock app's name, positioned above the dock in code. -->
    <TextView
        android:id="@+id/heroName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="68dp"
        android:alpha="0"
        android:textColor="@color/cyber_text"
        android:textSize="30sp"
        android:fontFamily="@font/rajdhani_bold"
        android:letterSpacing="0.1"
        android:textAllCaps="true"
        android:shadowColor="@color/cyber_cyan"
        android:shadowRadius="12"
        android:shadowDx="0"
        android:shadowDy="0"
        android:includeFontPadding="false"
        android:singleLine="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="26dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/leftBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/topButtons"
                android:layout_marginEnd="16dp"
                android:orientation="vertical">

                <!-- gravity left, not start: see the stock layout (no supportsRtl). -->
                <TextView
                    android:id="@+id/greeting"
                    android:gravity="left"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:layout_marginStart="3dp"
                    android:textColor="@color/cyber_pink"
                    android:textSize="12sp"
                    android:fontFamily="@font/jetbrains_mono"
                    android:letterSpacing="0.25"
                    android:textAllCaps="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="true">

                    <TextClock
                        android:id="@+id/clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="h:mm"
                        android:format24Hour="HH:mm"
                        android:textColor="@color/cyber_cyan"
                        android:textSize="64sp"
                        android:fontFamily="@font/rajdhani_bold"
                        android:letterSpacing="0.02"
                        android:shadowColor="@color/cyber_cyan"
                        android:shadowRadius="18"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:includeFontPadding="false" />

                    <TextClock
                        android:id="@+id/ampm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="10dp"
                        android:format12Hour="a"
                        android:format24Hour=""
                        android:textColor="@color/cyber_text_mid"
                        android:textSize="14sp"
                        android:fontFamily="@font/jetbrains_mono"
                        android:letterSpacing="0.1"
                        android:textAllCaps="true" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="26dp"
                        android:layout_gravity="bottom"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="10dp"
                        android:background="@color/cyber_cyan_edge" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="11dp"
                        android:orientation="vertical">

                        <!-- Shamsi date, shown when shamsi_date is on. -->
                        <TextView
                            android:id="@+id/shamsiDate"
                            android:gravity="left"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:textColor="@color/cyber_text"
                            android:textSize="16sp"
                            android:fontFamily="@font/jetbrains_mono"
                            android:letterSpacing="0.05"
                            android:includeFontPadding="false"
                            android:visibility="gone" />

                        <TextClock
                            android:id="@+id/date"
                            android:gravity="left"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:format12Hour="@string/date_format"
                            android:format24Hour="@string/date_format"
                            android:textColor="@color/cyber_dim"
                            android:textSize="12sp"
                            android:fontFamily="@font/jetbrains_mono"
                            android:letterSpacing="0.12"
                            android:textAllCaps="true" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/topButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignBottom="@id/leftBlock"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnInputs"
                    style="@style/TopButton"
                    android:text="@string/inputs"
                    android:drawableStart="@drawable/ic_input"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnWifi"
                    style="@style/TopButton"
                    android:maxWidth="200dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="@string/wifi"
                    android:drawableStart="@drawable/ic_wifi"
                    android:nextFocusDown="@+id/grid" />

                <!-- TXT / IMG: switches the tiles between text and banner artwork (TileLookButton). -->
                <com.gathin.tvhome.TileLookButton
                    android:id="@+id/btnTileLook"
                    style="@style/TopButton"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnSettings"
                    style="@style/TopButton"
                    android:text="@string/settings"
                    android:drawableStart="@drawable/ic_settings"
                    android:nextFocusDown="@+id/grid" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Shelf band: the focused app's name (heroName, in the root, placed by MainActivity from the parked
             dock's top) lives here, outside the grid, so rows scrolled up slide under the band instead of over
             the name. 58dp makes the parked dock land just under the band (MainActivity's top padding ends up
             near 0dp). It is its own view rather than a top margin on the wrapper: LinearLayout drops a negative
             margin sum (10dp - 36dp) from its total, and the 26dp that leaves free under the bottom module is
             part of the tuned look; a bigger top margin would make the sum positive and push the module down. -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="58dp" />

        <!-- The wrapper clips at the grid's edge; the grid itself must not clip so scaled tiles can overflow their cells.
             It reaches 36dp under the bottom module: MainActivity parks the visible rows 30dp above the grid's
             bottom, so this lowers them and hides the peeking third row behind the panels. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="-36dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="10dp"
                android:paddingBottom="0dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:descendantFocusability="afterDescendants" />
        </FrameLayout>

        <!-- Bottom module: the Helios lamp control and the system status. The Helios panel is the
             focusable view under the grid (@id/belowGrid, declared in main's ids.xml): Down on the
             grid's last row lands on it, and it sends Up and Back to the tile focus came from;
             OK, hold OK, Left/Right and Down drive the lamp (HeliosPanel). Its children copy its
             drawable state so the whole panel turns cyan with dark text while focused, like the
             top buttons. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="22dp"
            android:orientation="horizontal">

            <com.gathin.tvhome.HeliosPanel
                android:id="@id/belowGrid"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:background="@drawable/panel_bg"
                android:focusable="true"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                app:panel="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:duplicateParentState="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:duplicateParentState="true">

                        <TextView
                            android:id="@+id/helios_title"
                            style="@style/CyberModuleTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:textColor="@drawable/panel_title_text"
                            android:duplicateParentState="true"
                            android:text="@string/cyber_module_title" />

                        <!-- Replaces the title while the panel is focused (HeliosPanel.render). -->
                        <TextView
                            android:id="@+id/helios_hint"
                            style="@style/CyberModuleTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:textColor="@drawable/panel_title_text"
                            android:duplicateParentState="true"
                            android:visibility="gone"
                            android:letterSpacing="0.08"
                            android:text="@string/helios_keys" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/helios_line"
                        style="@style/CyberModuleBody"
                        android:textColor="@drawable/pill_text"
                        android:duplicateParentState="true" />
                </LinearLayout>
            </com.gathin.tvhome.HeliosPanel>

            <com.gathin.tvhome.CyberTileFrame
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:background="@color/cyber_panel"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                app:panel="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/CyberModuleTitle"
                        android:text="@string/cyber_status_title" />

                    <com.gathin.tvhome.SysStatusView
                        style="@style/CyberModuleBody" />
                </LinearLayout>
            </com.gathin.tvhome.CyberTileFrame>
        </LinearLayout>
    </LinearLayout>

    <!-- Static CRT scanlines over everything but the focus frame. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scanlines"
        android:importantForAccessibility="no" />

    <!-- The single floating neon frame that springs between tiles. -->
    <com.gathin.tvhome.NeonGlassView
        android:id="@+id/glass"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:alpha="0"
        android:importantForAccessibility="no" />
</FrameLayout>
